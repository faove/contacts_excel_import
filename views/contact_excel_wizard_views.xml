<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_contact_excel_wizard_form" model="ir.ui.view">
        <field name="name">contact.excel.wizard.form</field>
        <field name="model">contact.excel.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar contactos desde Excel">
                <group>
                    <field name="file" filename="file_name"/>
                    <field name="file_name"/>
                </group>
                <footer>
                    <button string="Importar" type="object" name="action_import_excel" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
